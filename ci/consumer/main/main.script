-- Smallest real consumer of the SDK: it requires the Lua wrapper and calls a
-- native entry point, so the bundle fails if the Lua module is missing. A
-- missing JS bridge symbol fails the link on its own, because every native
-- function is registered in Module_methods in yes2sdk.cpp. It never reaches a
-- Yes2 backend.
local yes2sdk_api = require "yes2sdk.yes2sdk"

function init(self)
  print("[yes2sdk-ci-consumer] platform=" .. tostring(yes2sdk_api.get_platform()))
end
