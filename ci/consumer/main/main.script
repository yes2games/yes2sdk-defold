-- Smallest real consumer of the SDK: it requires the Lua wrapper and touches a
-- native entry point, so the bundle fails if either the Lua module or the
-- native extension symbols are missing. It never reaches a Yes2 backend.
local yes2sdk_api = require "yes2sdk.yes2sdk"

function init(self)
  print("[yes2sdk-ci-consumer] platform=" .. tostring(yes2sdk_api.get_platform()))

  -- Link check: referencing every native entry point keeps its JS bridge symbol
  -- in the bundle, so a missing symbol fails the build. Never executed.
  if false then
    local _ = yes2sdk.on_exit_requested
    local _ = yes2sdk.session_get_entry_point_data
    local _ = yes2sdk.auth_show_registration_prompt
    local _ = yes2sdk.auth_registration_prompt_login
    local _ = yes2sdk.auth_registration_prompt_close
    local _ = yes2sdk.data_set_string_async
    local _ = yes2sdk.data_flush
    local _ = yes2sdk.player_flush_data
    local _ = yes2sdk.referrals_share
    local _ = yes2sdk.referrals_list
    local _ = yes2sdk.referrals_is_supported
    local _ = yes2sdk.notifications_schedule
    local _ = yes2sdk.notifications_cancel
    local _ = yes2sdk.notifications_cancel_all
    local _ = yes2sdk.notifications_is_supported
    local _ = yes2sdk.context_share
    local _ = yes2sdk.context_is_supported
    local _ = yes2sdk.iap_get_subscriptions
    local _ = yes2sdk.iap_subscribe
    local _ = yes2sdk.iap_cancel_subscription
    local _ = yes2sdk.iap_claim_retention_offer
    local _ = yes2sdk.iap_get_subscription_status
    local _ = yes2sdk.iap_is_subscription_supported
  end
end
